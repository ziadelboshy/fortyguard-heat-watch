# Copy to .env (git-ignored) and fill in:
#   cp .env.example .env
#   python3 scripts/setup_n8n.py --env-file .env
FORTYGUARD_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: timezone for n8n's hourly schedule (Docker Compose reads it from .env).
# Alert times are always shown in each monitor's own timezone.
# GENERIC_TIMEZONE=UTC
